          "id": "dfb92de3-2516-4174-abb2-8792e2c6d903",
          "name": "FastDOL Claim PDF Report",
          "request": {
            "name": "FastDOL Claim PDF Report",
            "description": {
              "content": "Hard-cap claim for one PDF report. Returns 429 if the customer is\nat quota. Caller (the report page) refuses to render on 429 and\nshows an upgrade prompt instead.\n\nAtomic check-and-increment via SELECT ... FOR UPDATE inside a\ntransaction. If the limit is 0 (Free tier), the customer never gets\npast the comparison — no slot is consumed and the upgrade response\nis consistent.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "usage",
                "pdf-report-claim"
