          "id": "7ac49818-ab56-467d-a6b4-f685f13bd0eb",
          "name": "FastDOL Stripe Webhook Tombstone",
          "request": {
            "name": "FastDOL Stripe Webhook Tombstone",
            "description": {
              "content": "No-op accept for Stripe webhook deliveries post-redesign.\n\nReturns 200 immediately so Stripe's retry loop doesn't keep\nre-queuing events. We don't read the body, don't verify the\nsignature, don't log anything sensitive.\n\nPer-IP throttle keeps a non-Stripe attacker from using this\nunauthenticated endpoint as cheap bandwidth — legitimate Stripe\ndeliveries come from many edge IPs and won't hit the cap.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "webhooks",
                "stripe"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "4e78925e-cbdb-4fc6-a76b-8ae6c5586bd4",
              "name": "Successful Response",
