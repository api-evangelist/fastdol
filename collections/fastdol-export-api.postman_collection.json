          "name": "FastDOL Create Export",
          "request": {
            "name": "FastDOL Create Export",
            "description": {
              "content": "Start a bulk export job. Returns 202 with a job_id to poll.\n\nAt least one filter field must be set — unfiltered exports would\nscan the entire employer table and are refused.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "export"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
