              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"format\": \"csv\",\n  \"filters\": {\n    \"name\": \"<string>\",\n    \"ein\": \"<string>\",\n    \"state\": \"<string>\",\n    \"states\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"zip\": \"<string>\",\n    \"naics\": \"<string>\",\n    \"naics_codes\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"parent_only\": false,\n    \"parent_name\": \"<string>\",\n    \"has_fatalities\": false,\n    \"svep\": false,\n    \"min_inspections\": \"<integer>\",\n    \"min_violations\": \"<integer>\",\n    \"min_penalties\": \"<number>\",\n    \"min_fatalities\": \"<integer>\",\n    \"min_whd_cases\": \"<integer>\",\n    \"min_whd_backwages\": \"<number>\"\n  },\n  \"max_rows\": 50000,\n  \"sort_by\": \"<string>\",\n  \"sort_dir\": \"desc\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
