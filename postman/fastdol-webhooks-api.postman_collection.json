      "name": "webhooks",
      "item": [
        {
          "name": "stripe",
          "item": [
            {
              "name": "FastDOL Stripe Webhook Tombstone",
              "id": "9c442856-99d4-43a4-a42d-aafb9613d520",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/webhooks/stripe",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "webhooks",
                    "stripe"
                  ]
                },
                "description": "No-op accept for Stripe webhook deliveries post-redesign.\n\nReturns 200 immediately so Stripe's retry loop doesn't keep\nre-queuing events. We don't read the body, don't verify the\nsignature, don't log anything sensitive.\n\nPer-IP throttle keeps a non-Stripe attacker from using this\nunauthenticated endpoint as cheap bandwidth \u2014 legitimate Stripe\ndeliveries come from many edge IPs and won't hit the cap."
              },
              "response": [
                {
                  "id": "0f991c56-cbbc-452b-b0a2-66e42a1ebd21",
                  "name": "Successful Response",
                  "originalRequest": {
